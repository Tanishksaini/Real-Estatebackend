              "raw": "{{baseUrl}}/api/me/recently-viewed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "recently-viewed"]
            }
          }
        },
        {
          "name": "GET /api/me/contacted",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/contacted",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "contacted"]
            }
          }
        },
        {
          "name": "GET /api/me/notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "notifications"]
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "GET /api/properties (search/filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?sort=latest&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "sort", "value": "latest" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/properties (nearest)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?sort=nearest&lat={{lat}}&lng={{lng}}&radiusKm={{radiusKm}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "sort", "value": "nearest" },
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" },
                { "key": "radiusKm", "value": "{{radiusKm}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "POST /api/properties (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.property && json.property._id) pm.environment.set('propertyId', json.property._id);",
                  "if (json && json.property && json.property.id) pm.environment.set('propertyId', json.property.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"plot\",\n  \"ownershipType\": \"owner\",\n  \"title\": \"100 Gaz Corner Plot Near Main Road\",\n  \"description\": \"Test listing\",\n  \"location\": {\n    \"state\": \"UP\",\n    \"city\": \"Meerut\",\n    \"localArea\": \"Ganga Nagar\",\n    \"landmark\": \"Near Market\",\n    \"pinCode\": \"250001\"\n  },\n  \"geo\": { \"lat\": 28.9845, \"lng\": 77.7064 },\n  \"area\": { \"value\": 100, \"unit\": \"gaz\" },\n  \"price\": { \"total\": 2000000, \"negotiable\": true },\n  \"specs\": { \"cornerPlot\": true, \"roadWidth\": \"20ft\", \"facing\": \"east\" },\n  \"amenities\": [\"Water Supply\", \"Electricity\"]\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"]
            }
          }
        },
        {
          "name": "GET /api/properties/:id (detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}"]
            }
          }
        },
        {
          "name": "PATCH /api/properties/:id (update)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"price\": { \"total\": 2100000 }\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}"]
            }
          }
        },
        {
          "name": "POST /api/properties/:id/favorite (toggle)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/favorite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "favorite"]
            }
          }
        },
        {
          "name": "POST /api/properties/:id/contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"call\"\n}\n" },
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "contact"]
            }
          }
        },
        {
          "name": "POST /api/properties/:id/share",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "share"]
            }
          }
        },
        {
          "name": "GET /api/properties/:id/similar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/similar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "similar"]
            }
          }
        },
        {
          "name": "GET /api/properties/:id/seller",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/seller",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "seller"]
            }
          }
        },
        {
          "name": "POST /api/properties/:id/mark-sold",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/mark-sold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}", "mark-sold"]
            }
          }
        },
        {
          "name": "DELETE /api/properties/:id (delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{propertyId}}"]
            }
          }
        }
      ]
    }
  ]
}

