              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"8888888888\"\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            }
          }
        },
        {
          "name": "GET /api/me/favorites",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/favorites",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "favorites"]
            }
          }
        },
        {
          "name": "GET /api/me/recently-viewed",
          "request": {
            "method": "GET",
            "header": [],
