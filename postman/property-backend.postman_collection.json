    {
      "name": "Properties",
      "item": [
        {
          "name": "GET /api/properties (search/filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?sort=latest&limit=10&city=Meerut",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "sort", "value": "latest" },
                { "key": "limit", "value": "10" },
                { "key": "city", "value": "Meerut", "disabled": true },
                { "key": "type", "value": "plot", "disabled": true },
                { "key": "featured", "value": "true", "disabled": true },
                { "key": "verifiedOnly", "value": "true", "disabled": true },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true }
              ]
            },
            "description": "Search & filter: sort, city, type, featured, verifiedOnly, minPrice, maxPrice, page, limit"
          }
        },
        {
          "name": "GET /api/properties/nearest (dedicated endpoint)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/nearest?lat={{lat}}&lng={{lng}}&radiusKm={{radiusKm}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "nearest"],
              "query": [
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" },
                { "key": "radiusKm", "value": "{{radiusKm}}" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Get properties near coordinates. lat & lng required."
          }
        },
        {
          "name": "GET /api/properties/my-listings (auth - user's listings)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/my-listings?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "my-listings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Auth required. Get all properties listed by logged-in user with pagination. Returns page, limit, total, and items."
          }
        },
        {
          "name": "POST /api/properties (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.property && json.property._id) pm.environment.set('propertyId', json.property._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "plot", "type": "text" },
                { "key": "ownershipType", "value": "owner", "type": "text" },
                { "key": "title", "value": "100 Gaz Corner Plot Near Main Road", "type": "text" },
                { "key": "description", "value": "Test listing", "type": "text" },
                { "key": "location", "value": "{\"state\":\"UP\",\"city\":\"Meerut\",\"localArea\":\"Ganga Nagar\",\"landmark\":\"Near Market\",\"pinCode\":\"250001\"}", "type": "text" },
                { "key": "geo", "value": "{\"lat\":28.0129,\"lng\":77.7064}", "type": "text", "disabled": true },
                { "key": "lat", "value": "28.0129", "type": "text" },
                { "key": "lng", "value": "77.7064", "type": "text" },
                { "key": "area", "value": "{\"value\":100,\"unit\":\"gaz\"}", "type": "text" },
                { "key": "price", "value": "{\"total\":2000000,\"negotiable\":true}", "type": "text" },
                { "key": "specs", "value": "{\"cornerPlot\":true,\"roadWidth\":\"20ft\",\"facing\":\"east\"}", "type": "text" },
