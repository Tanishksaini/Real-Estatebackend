{
  "info": {
    "name": "Property Backend API",
    "description": "Property backend — JWT auth (email/password), EmailJS OTP forgot-password, properties CRUD.\n\n**Auth flow (recommended order):**\n1. Signup (confirmPassword required)\n2. Login\n3. Forgot password → OTP email (EmailJS)\n4. Reset password → email + otp + password + confirmPassword\n\n**Env vars:** `baseUrl`, `email`, `password`, `resetOtp`, `token`, `propertyId`\n\nDev tip: set `PASSWORD_RESET_RETURN_OTP=true` in `.env` so forgot-password returns `otp` in response for Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get('token');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Signup needs confirmPassword. Forgot-password sends 6-digit OTP via EmailJS. Reset-password needs email, otp, password, confirmPassword.",
      "item": [
        {
          "name": "1. POST /api/auth/signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.environment.set('token', json.token);",
                  "if (json.user && json.user.id) pm.environment.set('userId', json.user.id);",
                  "if (json.user && json.user.email) pm.environment.set('email', json.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"phone\": \"9999999999\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "2. POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.environment.set('token', json.token);",
                  "if (json.user && json.user.id) pm.environment.set('userId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "3. POST /api/auth/forgot-password (EmailJS OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has message', () => pm.expect(json.message).to.be.a('string'));",
                  "if (json.otp) {",
                  "  pm.environment.set('resetOtp', json.otp);",
                  "  console.log('OTP saved to resetOtp (dev mode)');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Sends 6-digit OTP to email via EmailJS. If PASSWORD_RESET_RETURN_OTP=true, response includes `otp` and Postman saves it to `resetOtp`."
          }
        },
        {
          "name": "4. POST /api/auth/reset-password (OTP + confirmPassword)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.environment.set('token', json.token);",
                  "pm.test('Password reset message', () => pm.expect(json.message).to.include('successful'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{resetOtp}}\",\n  \"password\": \"newsecret123\",\n  \"confirmPassword\": \"newsecret123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "After forgot-password, enter OTP from email into `resetOtp` env (or use dev auto-save). Updates password and returns new JWT."
          }
        }
      ]
    },
    {
