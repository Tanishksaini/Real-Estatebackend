            "description": "Enquiries submitted by logged-in buyer"
          }
        },
        {
          "name": "GET /api/me/notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items[0] && json.items[0]._id) {",
                  "  pm.environment.set('notificationId', json.items[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/me/notifications"
          }
        },
        {
          "name": "POST /api/me/notifications/:id/read",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/me/notifications/{{notificationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /api/users/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "GET /api/properties (search/filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?sort=latest&limit=10&city=Meerut",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "sort", "value": "latest" },
                { "key": "limit", "value": "10" },
                { "key": "city", "value": "Meerut", "disabled": true },
                { "key": "type", "value": "plot", "disabled": true },
                { "key": "verifiedOnly", "value": "true", "disabled": true },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET /api/properties (nearest)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?sort=nearest&lat={{lat}}&lng={{lng}}&radiusKm={{radiusKm}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "sort", "value": "nearest" },
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" },
                { "key": "radiusKm", "value": "{{radiusKm}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "POST /api/properties (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.property && json.property._id) pm.environment.set('propertyId', json.property._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"plot\",\n  \"ownershipType\": \"owner\",\n  \"title\": \"100 Gaz Corner Plot Near Main Road\",\n  \"description\": \"Test listing\",\n  \"location\": {\n    \"state\": \"UP\",\n    \"city\": \"Meerut\",\n    \"localArea\": \"Ganga Nagar\",\n    \"landmark\": \"Near Market\",\n    \"pinCode\": \"250001\"\n  },\n  \"geo\": { \"lat\": {{lat}}, \"lng\": {{lng}} },\n  \"area\": { \"value\": 100, \"unit\": \"gaz\" },\n  \"price\": { \"total\": 2000000, \"negotiable\": true },\n  \"specs\": { \"cornerPlot\": true, \"roadWidth\": \"20ft\", \"facing\": \"east\" },\n  \"amenities\": [\"Water Supply\", \"Electricity\"]\n}"
            },
            "url": "{{baseUrl}}/api/properties"
          }
        },
        {
          "name": "GET /api/properties/:id (detail + viewCount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Has viewCount', () => pm.expect(json.property.viewCount).to.be.a('number'));",
                  "pm.test('Has enquiryCount', () => pm.expect(json.property.enquiryCount).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}",
            "description": "Returns property with viewCount, enquiryCount, and analytics. Each view increments viewCount."
          }
        },
        {
          "name": "GET /api/properties/:id/analytics (owner)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/analytics",
            "description": "Owner only — views, enquiries, favorites, calls, shares"
          }
        },
        {
          "name": "PATCH /api/properties/:id (update)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"price\": { \"total\": 2100000 }\n}"
            },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}"
          }
        },
        {
          "name": "POST /api/properties/:id/media (upload)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "photos", "type": "file", "src": [], "description": "Select image files (min 5 for listing)" },
                { "key": "photos", "type": "file", "src": [] },
                { "key": "videos", "type": "file", "src": [], "disabled": true },
                { "key": "registry", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/media",
            "description": "Owner only. multipart: photos[], videos[], registry, saleDeed, taxReceipt"
          }
        },
        {
          "name": "POST /api/properties/:id/favorite (toggle)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/favorite"
          }
        },
        {
          "name": "POST /api/properties/:id/enquiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.enquiry && json.enquiry._id) pm.environment.set('enquiryId', json.enquiry._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Buyer Name\",\n  \"phone\": \"9876543210\",\n  \"message\": \"I am interested in this property. Please contact me.\"\n}"
            },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/enquiry",
            "description": "Auth required. Buyer submits enquiry on active property (not own listing)."
          }
        },
        {
          "name": "GET /api/properties/:id/enquiries (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items[0] && json.items[0]._id) pm.environment.set('enquiryId', json.items[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/enquiries",
            "description": "Owner only — all enquiries for this property"
          }
        },
        {
          "name": "PATCH /api/properties/:id/enquiries/:enquiryId (owner)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\"\n}"
            },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/enquiries/{{enquiryId}}",
            "description": "Owner updates enquiry status: pending | contacted | closed"
          }
        },
        {
          "name": "POST /api/properties/:id/contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"call\"\n}"
            },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/contact"
          }
        },
        {
          "name": "POST /api/properties/:id/share",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/share"
          }
        },
        {
          "name": "GET /api/properties/:id/similar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/similar"
          }
        },
        {
          "name": "GET /api/properties/:id/seller",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/seller"
          }
        },
        {
          "name": "POST /api/properties/:id/mark-sold",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/mark-sold"
          }
        },
        {
          "name": "DELETE /api/properties/:id (delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}"
          }
        }
      ]
    }
  ]
}
